<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV136 — dlq_messages table for DLQ consumer persistence
 WHAT:    Stores messages that landed on the dead-letter queue so admins
          can inspect and replay them via POST /api/v1/admin/dlq/replay.
 WHY:     Without persistence the DLQ is fire-and-forget; ops cannot see
          what failed or replay it after a fix is deployed.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="012-create-dlq-messages" author="trainer">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="dlq_messages"/></not>
        </preConditions>
        <createTable tableName="dlq_messages">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="event_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="trade_ref" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="original_topic" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="partition_num" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="offset_val" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="VARCHAR(10000)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(10000)"/>
            <column name="first_seen" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="dlq_messages" indexName="idx_dlq_messages_event_id">
            <column name="event_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="dlq_messages"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
